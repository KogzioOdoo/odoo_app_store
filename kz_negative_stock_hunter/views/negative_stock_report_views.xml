<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Negative Stock List View -->
    <record id="negative_stock_report_view_list" model="ir.ui.view">
        <field name="name">negative.stock.report.list</field>
        <field name="model">negative.stock.report</field>
        <field name="arch" type="xml">
            <list string="Negative Stock" create="0" edit="0" delete="0">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="quantity"
                       decoration-danger="quantity &lt; 0"/>
                <field name="value"
                       decoration-danger="value &lt; 0"/>
                <field name="last_move_id"/>
                <field name="last_move_date"/>
                <field name="last_move_user_id"
                       widget="many2one_avatar_user"/>
                <field name="warehouse_id" optional="hide"/>
            </list>
        </field>
    </record>


    <!-- Negative Stock Form View -->
    <record id="negative_stock_report_view_form" model="ir.ui.view">
        <field name="name">negative.stock.report.form</field>
        <field name="model">negative.stock.report</field>
        <field name="arch" type="xml">
            <form string="Negative Stock" create="0" edit="0" delete="0">
                <sheet>
                    <div name="button_box" class="oe_button_box">

                        <button name="action_open_physical_inventory"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes"
                                string="Physical Inventory"/>

                        <button name="action_open_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                string="Purchase Orders"/>

                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="quantity" readonly="1"
                                   decoration-danger="quantity &lt; 0"/>
                            <field name="value" readonly="1"
                                   decoration-danger="value &lt; 0"/>
                        </group>
                        <group>

                            <field name="location_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Last Stock Moves" name="last_moves">
                            <field name="move_line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="reference"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="create_uid"
                                           widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>



    <record id="negative_stock_report_view_search" model="ir.ui.view">
    <field name="name">negative.stock.report.search</field>
    <field name="model">negative.stock.report</field>
    <field name="arch" type="xml">
        <search string="Negative Stock">

            <!-- Search fields -->
            <field name="product_id"/>
            <field name="product_categ_id"/>
            <field name="location_id"/>
            <field name="warehouse_id"/>
            <field name="company_id"/>

            <!-- Filters -->
            <separator/>

            <filter name="filter_negative_quantity"
                    string="Negative Quantity"
                    domain="[('quantity', '&lt;', 0)]"/>

            <filter name="filter_negative_value"
                    string="Negative Value"
                    domain="[('value', '&lt;', 0)]"/>

            <!-- Group By -->
            <group>
                <filter name="group_by_product_category"
                        string="Product Category"
                        context="{'group_by': 'product_categ_id'}"/>
                <filter name="group_by_location"
                        string="Location"
                        context="{'group_by': 'location_id'}"/>
                <filter name="group_by_warehouse"
                        string="Warehouse"
                        context="{'group_by': 'warehouse_id'}"/>
            </group>
        </search>
    </field>
</record>


    <!-- Negative Stock Window Action -->
    <record id="negative_stock_report_action" model="ir.actions.act_window">
        <field name="name">Negative Stock</field>
        <field name="res_model">negative.stock.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="negative_stock_report_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No negative stock found
            </p>
            <p>All reported stock quantities are zero or positive.</p>
        </field>
    </record>

</odoo>
