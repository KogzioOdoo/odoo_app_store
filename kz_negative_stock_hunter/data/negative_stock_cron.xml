<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_negative_stock_alert" model="ir.cron">
        <field name="name">Negative Stock Hunter: Check Stock</field>
        <field name="model_id" ref="model_negative_stock_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_negative_stock()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_negative_stock_daily_summary" model="ir.cron">
        <field name="name">Negative Stock Hunter: Daily Summary</field>
        <field name="model_id" ref="model_negative_stock_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_summary()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
