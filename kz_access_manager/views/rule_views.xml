<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="model_rule_form" model="ir.ui.view">
        <field name="name">am.model.rule.form</field>
        <field name="model">am.model.rule</field>
        <field name="arch" type="xml">
            <form string="Model Restriction">
                <sheet>
                    <group>
                        <field name="profile_id"/>
                        <field name="model_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <group string="Data Permissions">
                            <field name="deny_read"/>
                            <field name="deny_create"/>
                            <field name="deny_write"/>
                            <field name="deny_unlink"/>
                        </group>
                        <group string="Record Actions">
                            <field name="no_import"/>
                            <field name="no_export"/>
                            <field name="no_duplicate"/>
                            <field name="no_archive"/>
                        </group>
                    </group>
                    <group>
                        <group string="Chatter">
                            <field name="hide_chatter"/>
                            <field name="hide_send_message"/>
                            <field name="hide_log_note"/>
                            <field name="hide_activity"/>
                        </group>
                        <group string="Views &amp; Search">
                            <field name="hidden_view_type_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                            <field name="available_view_type_ids" invisible="1"/>
                            <field name="hide_search_panel"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="field_rule_form" model="ir.ui.view">
        <field name="name">am.field.rule.form</field>
        <field name="model">am.field.rule</field>
        <field name="arch" type="xml">
            <form string="Field Restriction">
                <sheet>
                    <group>
                        <field name="profile_id"/>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="condition" placeholder="e.g. state == 'draft'"/>
                    </group>
                    <group>
                        <group string="Field Behavior">
                            <field name="invisible"/>
                            <field name="readonly"/>
                            <field name="required"/>
                        </group>
                        <group string="Relational Fields">
                            <field name="no_open"/>
                            <field name="no_create"/>
                        </group>
                    </group>
                    <group string="Data Tools">
                        <field name="no_export"/>
                        <field name="no_filter"/>
                        <field name="no_group"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p>Invisible fields remain readable through APIs and may be fetched for view expressions. Use native field group security for confidential values.</p>
                        <p>Condition example: state == 'draft'. Use only fields that exist in the view.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="domain_rule_form" model="ir.ui.view">
        <field name="name">am.domain.rule.form</field>
        <field name="model">am.domain.rule</field>
        <field name="arch" type="xml">
            <form string="Record Domain">
                <sheet>
                    <group><field name="profile_id"/>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="model_name" invisible="1"/></group>
                    <group>
                        <field name="domain" widget="domain" options="{'model': 'model_name'}"/>
                    </group>
                    <group string="Apply To">
                        <field name="for_read"/>
                        <field name="for_create"/>
                        <field name="for_write"/>
                        <field name="for_unlink"/>
                    </group>
                    <div class="alert alert-info" role="alert">The domain describes allowed records. Multiple domains combine with AND. Available variables: uid, company_id, company_ids. Example: [('user_id', '=', uid)].</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="node_rule_form" model="ir.ui.view">
        <field name="name">am.node.rule.form</field>
        <field name="model">am.node.rule</field>
        <field name="arch" type="xml">
            <form string="View Element Restriction">
                <sheet>
                    <group>
                        <field name="profile_id"/>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="kind"/>
                        <field name="node_name"/>
                        <field name="label"/>
                        <field name="condition" placeholder="e.g. state == 'draft'"/>
                    </group>
                    <p class="text-muted">Buttons, tabs, filters, and external links are presentation controls. Use model and record rules to secure business operations.</p>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
