<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="activity_feedback_wizard_view_form" model="ir.ui.view">
        <field name="name">activity.feedback.wizard.form</field>
        <field name="model">activity.feedback.wizard</field>
        <field name="arch" type="xml">
            <form string="Activity Feedback">
                <group>
                    <field name="activity_id" invisible="1"/>
                    <field name="feedback" placeholder="Write your feedback..."/>
                </group>
                <footer>
                    <button name="action_done" string="Done" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_done_schedule_next" string="Done &amp; Schedule Next" type="object" class="btn-secondary" data-hotkey="w"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
