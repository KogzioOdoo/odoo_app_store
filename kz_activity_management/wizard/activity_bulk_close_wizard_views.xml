<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="activity_bulk_close_wizard_form" model="ir.ui.view">
        <field name="name">activity.bulk.close.wizard.form</field>
        <field name="model">activity.bulk.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Activity Action">
                <group>
                    <field name="operation" invisible="1"/>
                    <field name="activity_ids" widget="many2many_tags" readonly="1"/>
                    <field name="feedback" invisible="operation != 'done'" placeholder="Optional completion feedback..."/>
                    <field name="reason" invisible="operation != 'cancel'" required="operation == 'cancel'" placeholder="Reason for cancellation..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_bulk_activity_done" model="ir.actions.server">
        <field name="name">Mark Activities as Done</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="binding_model_id" ref="mail.model_mail_activity"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = {'type': 'ir.actions.act_window', 'name': 'Mark Activities as Done', 'res_model': 'activity.bulk.close.wizard', 'view_mode': 'form', 'views': [(env.ref('kz_activity_management.activity_bulk_close_wizard_form').id, 'form')], 'target': 'new', 'context': {'active_model': 'mail.activity', 'active_ids': records.ids, 'default_operation': 'done'}}</field>
    </record>
    <record id="action_bulk_activity_cancel" model="ir.actions.server">
        <field name="name">Cancel Activities</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="binding_model_id" ref="mail.model_mail_activity"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = {'type': 'ir.actions.act_window', 'name': 'Cancel Activities', 'res_model': 'activity.bulk.close.wizard', 'view_mode': 'form', 'views': [(env.ref('kz_activity_management.activity_bulk_close_wizard_form').id, 'form')], 'target': 'new', 'context': {'active_model': 'mail.activity', 'active_ids': records.ids, 'default_operation': 'cancel'}}</field>
    </record>
</odoo>
