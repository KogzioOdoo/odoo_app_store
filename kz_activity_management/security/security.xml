<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="module_category_activity" model="ir.module.category">
        <field name="name">Activity Management</field>
        <field name="sequence">30</field>
    </record>
    <record id="res_groups_privilege_activity" model="res.groups.privilege">
        <field name="name">Activity Management</field>
        <field name="category_id" ref="module_category_activity"/>
    </record>
    <record id="group_activity_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="privilege_id" ref="res_groups_privilege_activity"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Can see and manage only their own activity.</field>
    </record>
    <record id="group_activity_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="privilege_id" ref="res_groups_privilege_activity"/>
        <field name="implied_ids" eval="[Command.link(ref('group_activity_employee'))]"/>
        <field name="comment">Can see own activity and the activity of the team.</field>
    </record>
    <record id="group_activity_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_activity"/>
        <field name="implied_ids" eval="[Command.link(ref('group_activity_supervisor'))]"/>
        <field name="comment">Can see all activity and configure the module.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_activity_manager'))]"/>
    </record>
</odoo>
