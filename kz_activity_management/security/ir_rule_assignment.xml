<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="mail_activity_rule_employee" model="ir.rule">
        <field name="name">Activity: employee sees own and assigned</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="groups" eval="[Command.link(ref('group_activity_employee'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('assigned_user_ids', 'in', [user.id])]</field>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="mail_activity_rule_supervisor" model="ir.rule">
        <field name="name">Activity: supervisor sees own, assigned and team</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="groups" eval="[Command.link(ref('group_activity_supervisor'))]"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('assigned_user_ids', 'in', [user.id]), ('supervisor_id', '=', user.id)]</field>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="mail_activity_rule_manager" model="ir.rule">
        <field name="name">Activity: manager sees all</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="groups" eval="[Command.link(ref('group_activity_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_create" eval="False"/>
    </record>
</odoo>
