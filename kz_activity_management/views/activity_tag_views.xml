<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="activity_tag_view_list" model="ir.ui.view">
        <field name="name">activity.tag.list</field>
        <field name="model">activity.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="activity_tag_view_search" model="ir.ui.view">
        <field name="name">activity.tag.search</field>
        <field name="model">activity.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="activity_tag_action" model="ir.actions.act_window">
        <field name="name">Activity Tags</field>
        <field name="res_model">activity.tag</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="activity_tag_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first activity tag</p>
        </field>
    </record>
</odoo>
