<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="portal_my_activity" name="My Activities">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h1 class="h3 mb-0">My Activities</h1>
                    <span class="badge text-bg-secondary">
                        <t t-esc="total"/> matching activities</span>
                </div>
                <form action="/my/activity" method="get" class="row g-2 mb-4">
                    <div class="col-12 col-md-5">
                        <label for="portal_activity_search" class="form-label">Search</label>
                        <input id="portal_activity_search" type="search" name="search" class="form-control" t-att-value="search" placeholder="Summary or document…"/>
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="portal_activity_status" class="form-label">Status</label>
                        <select id="portal_activity_status" name="status" class="form-select">
                            <option t-att-selected="selected_status == 'active'" value="active">Active</option>
                            <option t-att-selected="selected_status == 'today'" value="today">Today</option>
                            <option t-att-selected="selected_status == 'overdue'" value="overdue">Overdue</option>
                            <option t-att-selected="selected_status == 'done'" value="done">Completed</option>
                            <option t-att-selected="selected_status == 'cancelled'" value="cancelled">Cancelled</option>
                            <option t-att-selected="selected_status == 'all'" value="all">All History</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="portal_activity_sort" class="form-label">Sort</label>
                        <select id="portal_activity_sort" name="sortby" class="form-select">
                            <option value="deadline" t-att-selected="sortby == 'deadline'">Deadline</option>
                            <option value="summary" t-att-selected="sortby == 'summary'">Summary</option>
                            <option value="recent" t-att-selected="sortby == 'recent'">Recently Updated</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary w-100" type="submit">Apply</button>
                    </div>
                </form>
                <p class="text-muted small">You see activities explicitly assigned or shared with you in your permitted companies. Completing a shared task finishes it for every participant.</p>
                <div t-if="activity" class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Activity</th>
                                <th>Type</th>
                                <th>Deadline</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="activity" t-as="item">
                                <tr>
                                    <td>
                                        <a t-att-href="'/my/activity/%s' % item.id" t-esc="item.summary or item.display_name"/>
                                    </td>
                                    <td t-esc="item.activity_type_id.name"/>
                                    <td>
                                        <span t-field="item.date_deadline"/>
                                    </td>
                                    <td t-esc="dict(item._fields['state']._description_selection(request.env)).get(item.state, item.state)"/>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" t-att-href="'/my/activity/%s' % item.id">View</a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div t-else="" class="alert alert-info">No activities match this view. Try All History or clear the search. Contact your business representative if you expected an assignment.</div>
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>
    <template id="portal_activity_detail" name="Activity Details">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <a href="/my/activity" class="btn btn-link px-0 mb-3">← My Activities</a>
                <div class="card">
                    <div class="card-body p-3 p-md-4">
                        <h1 class="h3" t-esc="activity.summary or activity.display_name"/>
                        <p>
                            <span class="badge text-bg-secondary" t-esc="status_label"/>
                        </p>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Activity Type</strong>
                                <p t-esc="activity.activity_type_id.name"/>
                                <strong>Deadline</strong>
                                <p>
                                    <span t-field="activity.date_deadline"/>
                                </p>
                                <strong>Priority</strong>
                                <p t-esc="dict(activity._fields['priority']._description_selection(request.env)).get(activity.priority, 'Normal')"/>
                            </div>
                            <div class="col-md-6">
                                <strong>Supervisor</strong>
                                <p t-esc="activity.supervisor_id.name or '—'"/>
                                <strong>Estimated Hours</strong>
                                <p t-field="activity.estimated_hours" t-options="{'widget': 'float_time'}"/>
                                <strong>Time Spent</strong>
                                <p t-field="activity.time_spent" t-options="{'widget': 'float_time'}"/>
                            </div>
                        </div>
                        <div class="mb-3">
                            <h2 class="h6">Note Shared With Assignees</h2>
                            <div t-field="activity.note"/>
                        </div>
                        <p>
                            <t t-foreach="activity.tag_ids" t-as="tag">
                                <span class="badge text-bg-light me-1" t-esc="tag.name"/>
                            </t>
                        </p>
                        <div t-if="activity.cancelled_date" class="alert alert-secondary">
                            <strong>Cancellation Reason</strong>
                            <p class="mb-0" t-esc="activity.cancel_reason"/>
                        </div>
                        <div t-if="not activity.active and not activity.cancelled_date">
                            <h2 class="h6">Completion Feedback</h2>
                            <p t-esc="activity.feedback or 'No feedback was recorded.'"/>
                        </div>
                        <form t-if="activity.active" t-att-action="'/my/activity/%s/done' % activity.id" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label for="portal_feedback" class="form-label">Completion Feedback</label>
                            <textarea id="portal_feedback" name="feedback" maxlength="5000" class="form-control mb-3" placeholder="What was completed? (Optional)"/>
                            <p t-if="activity.assignment_type == 'shared'" class="small text-muted">This is one shared task. Marking it done completes it for all participants.</p>
                            <button type="submit" class="btn btn-success">Mark as Done</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="portal_home_activity" inherit_id="portal.portal_my_home" name="Portal Activity Home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="request.env.user.share and request.env.user.sudo().activity_portal_enabled" t-call="portal.portal_docs_entry">
                <t t-set="title">My Activities</t>
                <t t-set="url" t-value="'/my/activity'"/>
                <t t-set="placeholder_count" t-value="'activity_count'"/>
                <t t-set="config_card" t-value="True"/>
                <t t-set="text">View assigned work and completion history</t>
            </t>
        </xpath>
    </template>
</odoo>
