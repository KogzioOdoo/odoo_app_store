<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">
    <record id="mail_template_activity_due" model="mail.template">
        <field name="name">Activity Management: Activity Due Today</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="subject">Activity due today: {{ object.summary or object.activity_type_id.name }}</field>
        <field name="email_to">{{ object.user_id.partner_id.email_formatted }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0;">
                <p>Hello <t t-out="object.user_id.name or ''"/>,</p>
                <p>
                    Your activity <strong>
                        <t t-out="object.summary or object.activity_type_id.name or ''"/>
                    </strong>
                    on <t t-out="object.res_name or ''"/> is due today
                    (<t t-out="object.date_deadline or ''"/>).
                </p>
                <p>Please complete it before the day ends.</p>
            </div>
        </field>
    </record>
    <record id="mail_template_activity_missed" model="mail.template">
        <field name="name">Activity Management: Activity Missed</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="subject">Missed activity: {{ object.summary or object.activity_type_id.name }}</field>
        <field name="email_to">{{ object.user_id.partner_id.email_formatted }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0;">
                <p>Hello <t t-out="object.user_id.name or ''"/>,</p>
                <p>
                    Your activity <strong>
                        <t t-out="object.summary or object.activity_type_id.name or ''"/>
                    </strong>
                    on <t t-out="object.res_name or ''"/> was due on
                    <t t-out="object.date_deadline or ''"/> and is now overdue.
                </p>
                <p>Please complete or cancel it as soon as possible.</p>
            </div>
        </field>
    </record>
</odoo>
