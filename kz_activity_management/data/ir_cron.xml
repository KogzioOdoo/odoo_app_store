<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">
    <record id="ir_cron_create_recurring_activity" model="ir.cron">
        <field name="name">Activity Management: Create Recurring Activity</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_recurring_activity()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_send_activity_notifications" model="ir.cron">
        <field name="name">Activity Management: Due and Missed Notifications</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_activity_notifications()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
